{
  "name": "euxy-web",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "start": "node scripts/sync-shared.mjs && expo start --web",
    "export": "node scripts/sync-shared.mjs && expo export --platform web",
    "typecheck": "node scripts/sync-shared.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
