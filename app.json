{
  "expo": {
    "name": "euxy",
    "slug": "euxy",
    "owner": "brent-org",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "euxy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.brent.euxy",
      "appleTeamId": "GQ4S96SE9Z",
      "associatedDomains": [
        "applinks:euxy.expo.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/euxy.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.brent.euxy"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f4f4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 276,
          "dark": {
            "backgroundColor": "#08080A",
            "image": "./assets/images/splash-icon.png"
          },
          "android": {
            "image": "./assets/images/splash-cell.png",
            "imageWidth": 44,
            "dark": {
              "image": "./assets/images/splash-cell-dark.png"
            }
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image",
        {
          "disableLibdav1d": true
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ee288d6-807b-4316-8331-d0f5cd5eebe8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2ee288d6-807b-4316-8331-d0f5cd5eebe8"
    }
  }
}
