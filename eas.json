{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "sim": {
      "ios": {
        "simulator": true
      },
      "channel": "sim"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6794186602"
      }
    }
  }
}
