# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files
#
# NOTE: fingerprint.config.js sets sourceSkips: ['GitIgnore'], so this file's
# contents do NOT feed the EAS fingerprint. Editing a rule here will not
# produce a new fingerprint. That is deliberate — automation edits this file
# often, and a gitignore rule cannot change the native binary while ios/ and
# android/ stay uncommitted.
#
# Be careful if that ever stops being true: once ios/ or android/ are checked
# in, the rules here decide which native files get hashed, and a change that
# silently drops one from the fingerprint would no longer announce itself.
# Revisit fingerprint.config.js at that point.
#
# Also note .easignore does NOT inherit from this file — it fully replaces it
# for EAS uploads, so anything added here must be added there too.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# EAS Simulator session (carries a token)
.env.eas-simulator

# Internal tooling notes (carries a capability URL — purged from history 2026-07-25)
SETUP-TRACING.md

# Local agent tooling (session hooks/skills — never commit; a committed .codex/hooks.json
# auto-runs scripts for anyone who checks out the repo)
.agents/
.codex/

# Transient triage data — private inputs/analysis plus generated public PR
# metadata. Kept only as workflow artifacts; never committed into a branch.
.eas/crash-triage/crash.json
.eas/crash-triage/ANALYSIS.md
.eas/crash-triage/sim-sessions.txt
.eas/crash-triage/sim/
.eas/feedback-triage/feedback.json
.eas/feedback-triage/ANALYSIS.md
.eas/feedback-triage/PUBLIC_REPORT.json
.eas/feedback-triage/PUBLIC_PR.json
.eas/feedback-triage/sim/
.eas/public-evidence-site/dist/
.eas/agent-work/issue.json
.eas/agent-work/ANALYSIS.md
.eas/agent-work/PUBLIC_FINDINGS.json
.eas/agent-work/sim/
.eas/pr-review/feedback.md
.eas/pr-review/RESPONSE.md
.eas/pr-review/ACTIONS.json
.eas/pr-review/sim/
.github/pr-review/

# The rescued diff a triage run writes so its work survives a failed publish.
# Uploaded as a workflow artifact; never part of the branch it describes.
.eas/*/RESCUED_WORK.patch
.eas/*/RESCUED_WORK.md

# Argent writes into the project root when it drives a simulator: retrieved
# screen recordings (megabytes of mp4) and a project-scope feature-flag file.
# Nothing here belongs in a commit, and a wrapper's `git add -A` would otherwise
# stage recordings onto the branch it is about to push.
.argent/
