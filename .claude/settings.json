{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.hackathon-trace/trace_upload.py\" ] && python3 \"$HOME/.hackathon-trace/trace_upload.py\" --agent claude-code || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.hackathon-trace/trace_upload.py\" ] && python3 \"$HOME/.hackathon-trace/trace_upload.py\" --agent claude-code || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "paper-desktop@paper": true
  }
}
